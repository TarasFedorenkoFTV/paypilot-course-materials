# Local judge — L10. Keeps the release-layer measurement inside the perimeter.
#
#   ollama pull qwen2.5:7b
#   set -a && . solutions/l10_reference/judge.local.env && set +a
#   cd solutions/evals && python calibrate_judge.py
#
# Verified on: NOT YET MEASURED (no Ollama on the machine that built this
# reference). Acceptance thresholds are in
# docs/model-selection-recommendation.reference.md section 6, and were fixed
# BEFORE any run so the result cannot be graded after the fact.

JUDGE_BACKEND=ollama
JUDGE_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434

# The set and the rubric must be identical to the cloud runs, or the two
# statements are not comparable.
RUBRIC_VERSION=rubric.v1
JUDGE_RUNS=5

# Record with the result, per the contract in section 1:
#   model tag + digest:  ollama show qwen2.5:7b --modelfile | head -1
#   date of the run
